# 系统与编辑器临时文件
.DS_Store
*.swp
*.swo
*~
/.idea/
*.iml

# Android 本地配置与构建产物
/local.properties
/.gradle/
/.kotlin/
**/build/
*.jks
*.keystore

# 本地测试缓存
__pycache__/

# 模型二进制不入库:由 scripts/fetch_model.sh 校验下载(PRD §11)
/app/src/main/assets/sensevoice/
/cache/

# 用户语料录音不入库(AC-P0-020),manifest.csv 模板入库
/app/src/androidTest/assets/corpus/*.wav

# 本地构建下载缓存
/.cache/

# 本地环境配置
/.env
/.env.*
!/.env.example
/.local/

# 标识包可由已跟踪的目录内容重新打包
/docs/brand/*.zip
